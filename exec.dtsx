    <DTS:Executable
      DTS:refId="Package\ATUALIZAR CLASS CODE ANTIGO"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarefa Executar SQL"
      DTS:DTSID="{c69868d4-10b7-4481-aaa1-95d78c6eb715}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ATUALIZAR CLASS CODE ANTIGO"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{557165E4-FCA5-4F9D-AB80-94F4538469D0}"
          SQLTask:SqlStatementSource="-- ATUALIZAR O CLASS CODE DO ANTIGO D&#xA;UPDATE A&#xA;SET A.CD_LETRA = NULL,&#xA;A.CD_OPERACAO = NULL,&#xA;A.DT_INCLUSAO = NULL&#xA;FROM TB_CRDT_CLASSLIST_OI_EXPORT A&#xA;&#xA;WHERE CD_LETRA = 'D'" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ATUALIZAR MAILING D"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarefa Executar SQL"
      DTS:DTSID="{905830b1-d29f-4c9c-ac13-08cdc026261b}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ATUALIZAR MAILING D"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{557165E4-FCA5-4F9D-AB80-94F4538469D0}"
          SQLTask:SqlStatementSource="update a&#xA;&#xA;set a.cd_letra = 'D',&#xA;CD_OPERACAO = 'DEBITO_NIO',&#xA;DT_INCLUSAO = getdate()&#xA;from TB_CRDT_CLASSLIST_OI_EXPORT a &#xA;inner join&#xA;(&#xA;SELECT &#xA; CHAVE AS NUMERO_DOCUMENTO,&#xA; SUM(VL_FATURADO) AS TOTAL_DEBITO&#xA;FROM [dbo].[TB_CRDT_BASE_INADIMPLENCIA_LEGADO_NF]&#xA;&#xA;GROUP BY CHAVE&#xA;&#xA;) b&#xA;on nr_pessoa = numero_documento&#xA;&#xA;WHERE cd_letra NOT IN ('G','H','L')&#xA;&#xA;-----&#xA;&#xA;&#xA;update a&#xA;&#xA;set a.cd_letra = 'D',&#xA;CD_OPERACAO = 'DEBITO_NIO',&#xA;DT_INCLUSAO = getdate()&#xA;from TB_CRDT_CLASSLIST_OI_EXPORT a &#xA;inner join&#xA;(&#xA;SELECT &#xA; CHAVE AS NUMERO_DOCUMENTO,&#xA; SUM(VL_FATURADO) AS TOTAL_DEBITO&#xA;FROM [dbo].[TB_CRDT_BASE_INADIMPLENCIA_LEGADO_NF]&#xA;&#xA;GROUP BY CHAVE&#xA;&#xA;) b&#xA;on nr_pessoa = numero_documento&#xA;&#xA;WHERE cd_letra is null" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ATUALIZAR MEI"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarefa Executar SQL"
      DTS:DTSID="{a5ef8c08-0376-4514-9f6c-cd3243497c6a}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ATUALIZAR MEI"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{557165E4-FCA5-4F9D-AB80-94F4538469D0}"
          SQLTask:SqlStatementSource="UPDATE A&#xA;&#xA;SET A.CD_LETRA = D.CD_LETRA,&#xA;A.CD_OPERACAO = 'MAILING_PJ',&#xA;A.DT_INCLUSAO = GETDATE()&#xA;&#xA;FROM TB_CRDT_CLASSLIST_OI_EXPORT A&#xA;&#xA;INNER JOIN &#xA;(&#xA;&#xA; SELECT NR_PESSOA,&#xA; SCORE,&#xA; CASE WHEN ID_SITUACAO_CADASTRAL &lt;&gt; 'A' THEN 'L'&#xA;  ELSE &#xA;  CASE WHEN SCORE IS NULL THEN 'Q'&#xA;  WHEN SCORE &lt; 320 THEN 'Q'&#xA;  WHEN SCORE BETWEEN  321 AND 749 THEN 'K'&#xA;  WHEN SCORE   &gt;= 750 THEN 'R'&#xA;  END &#xA; END AS CD_LETRA&#xA;&#xA;&#xA; FROM &#xA; (&#xA;  SELECT A.*,&#xA;  B.SCORE &#xA;&#xA;  FROM &#xA;  (&#xA;   select NR_PESSOA,&#xA;   ID_SITUACAO_CADASTRAL,&#xA;   RIGHT('00000000000000' + DOCUMENTO,14) AS DOCUMENTO&#xA;   from &#xA;   (&#xA;    SELECT  a.*,&#xA;    b.MEI,&#xA;    b.ID_SITUACAO_CADASTRAL,&#xA;    b.SCORE_PJ_CUSTOMIZADO,&#xA;    ID_NATUREZA_JURIDICA&#xA;    FROM TB_CRDT_CLASSLIST_OI_EXPORT a &#xA;    inner join TB_CRDT_BASE_QUOD_FULL_PJ b on a.NR_PESSOA = b.CNPJ&#xA;&#xA;    WHERE CD_LETRA IS NULL and TIPO_DOC = '2'&#xA;   ) a&#xA;   INNER JOIN TB_CRDT_QUOD_BASE_QUADRO_SOCIETARIO B ON a.NR_PESSOA = B.CNPJ&#xA; &#xA;   where MEI = 'S'&#xA;  ) A &#xA;  INNER JOIN TB_CRDT_BASE_QUOD_BASE_PF B ON A.DOCUMENTO = B.CPF_14&#xA; ) C&#xA;) D&#xA;&#xA;ON A.NR_PESSOA = D.NR_PESSOA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ATUALIZAR NAO MEI"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarefa Executar SQL"
      DTS:DTSID="{b27bc395-c143-4f6e-bb40-6616c8387d30}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ATUALIZAR NAO MEI"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{557165E4-FCA5-4F9D-AB80-94F4538469D0}"
          SQLTask:SqlStatementSource="UPDATE A&#xA;&#xA;SET A.CD_LETRA = B.CD_LETRA,&#xA;A.CD_OPERACAO = 'MAILING_PJ',&#xA;A.DT_INCLUSAO = GETDATE()&#xA;&#xA;FROM TB_CRDT_CLASSLIST_OI_EXPORT A&#xA;&#xA;INNER JOIN &#xA;(&#xA;&#xA; select NR_PESSOA,&#xA; case when ID_SITUACAO_CADASTRAL &lt;&gt; 'A' THEN 'L'&#xA; ELSE &#xA;  CASE WHEN SCORE_PJ_CUSTOMIZADO &lt; 700 THEN 'Q'&#xA;  ELSE&#xA;   CASE WHEN ID_NATUREZA_JURIDICA = '2135' THEN 'S'&#xA;    ELSE 'W' END &#xA;  END&#xA; END AS CD_LETRA&#xA;&#xA; from &#xA; (&#xA;  SELECT  a.*,&#xA;  b.MEI,&#xA;  b.ID_SITUACAO_CADASTRAL,&#xA;  b.SCORE_PJ_CUSTOMIZADO,&#xA;  ID_NATUREZA_JURIDICA&#xA;  FROM TB_CRDT_CLASSLIST_OI_EXPORT a &#xA;  inner join TB_CRDT_BASE_QUOD_FULL_PJ b on a.NR_PESSOA = b.CNPJ&#xA;&#xA;  WHERE CD_LETRA IS NULL and TIPO_DOC = '2'&#xA; ) a where MEI = 'n'&#xA;) B ON A.NR_PESSOA = B.NR_PESSOA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ATUALIZAR TIPO DOCUMENTO"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarefa Executar SQL"
      DTS:DTSID="{475b9028-b925-43b0-8099-72bcc3a24d28}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ATUALIZAR TIPO DOCUMENTO"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{557165E4-FCA5-4F9D-AB80-94F4538469D0}"
          SQLTask:SqlStatementSource=" ---- incluir tipo de documento&#xA;&#xA; UPDATE A &#xA;SET A.TIPO_DOC = 2&#xA;FROM tb_crdt_classlist_oi_export a with(tablock)  &#xA;INNER JOIN TB_CRDT_BASE_QUOD_FULL_PJ B ON A.NR_PESSOA = B.CNPJ&#xA;WHERE TIPO_DOC IS NULL;&#xA;&#xA;UPDATE A &#xA;&#xA;SET A.TIPO_DOC = 1 &#xA;FROM tb_crdt_classlist_oi_export a with(tablock)&#xA;WHERE TIPO_DOC IS NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
