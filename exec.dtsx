          SQLTask:SqlStatementSource="alter index idx_doc on tb_crdt_classlist_oi_export rebuild partition = all&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
