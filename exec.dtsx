    <DTS:Executable
      DTS:refId="Package\CONSOLIDAR BASE"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarefa Executar SQL"
      DTS:DTSID="{a3c6502e-5273-4b89-b9c2-47854b43aad7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CONSOLIDAR BASE"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{557165E4-FCA5-4F9D-AB80-94F4538469D0}"
          SQLTask:SqlStatementSource="truncate table [dbo].[TB_CRDT_BASE_INADIMPLENCIA_LEGADO_NF];&#xA;insert into TB_CRDT_BASE_INADIMPLENCIA_LEGADO_NF&#xA;select A.*,&#xA;GETDATE() as DT_INCLUSAO&#xA;from &#xA;(&#xA;&#x9;select * From TB_CRDT_BASE_INADIMPLENCIA_LEGADO_NF_ENTRADA &#xA;&#x9;where VL_FATURADO &gt;= 100&#xA;) a " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\INCLUIR DOCS"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarefa Executar SQL"
      DTS:DTSID="{e70fecef-b170-42b0-97e9-833e2e18a5ca}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="INCLUIR DOCS"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{557165E4-FCA5-4F9D-AB80-94F4538469D0}"
          SQLTask:SqlStatementSource="insert into TB_CRDT_CLASSLIST_OI_EXPORT &#xA;(&#xA; NR_PESSOA,&#xA; CD_LETRA,&#xA; CD_OPERACAO,&#xA; DT_INCLUSAO&#xA;)&#xA;&#xA;select &#xA; NUMERO_DOCUMENTO as nr_pessoa,&#xA; 'D' AS CD_LETRA,&#xA; CD_OPERACAO = 'DEBITO_NIO',&#xA; GETDATE() AS DT_INCLUSAO&#xA;from &#xA;( &#xA;select A.*,&#xA;b.NR_PESSOA from&#xA;(&#xA; SELECT &#xA; CHAVE AS NUMERO_DOCUMENTO,&#xA; SUM(VL_FATURADO) AS TOTAL_DEBITO&#xA; FROM [dbo].[TB_CRDT_BASE_INADIMPLENCIA_LEGADO_NF]&#xA; GROUP BY CHAVE&#xA;) a &#xA;left join TB_CRDT_CLASSLIST_OI_EXPORT b  on A.numero_documento = b.NR_PESSOA&#xA;) c where NR_PESSOA is null" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\INCLUIR REGISTROS ALTERACAO INADIM"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarefa Executar SQL"
      DTS:DTSID="{318a2da0-1157-425f-bf51-02cb81cb0d61}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="INCLUIR REGISTROS ALTERACAO INADIM"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{557165E4-FCA5-4F9D-AB80-94F4538469D0}"
          SQLTask:SqlStatementSource="delete from TB_CRDT_EVOLUTIVO_INADIM&#xA;where CAST(dt_inclusao As date) = cast(GETDATE() as date);&#xA;&#xA;INSERT INTO [DBO].[TB_CRDT_EVOLUTIVO_INADIM]&#xA;(&#xA;&#x9;QUANTIDADE,&#xA;&#x9;SITUACAO_DOCUMENTO,&#xA;&#x9;STATUS_INADIM,&#xA;&#x9;MAILING_ATUAL,&#xA;&#x9;MAILING_ANTERIOR,&#xA;&#x9;TIPO_DOCUMENTO,&#xA;&#x9;DT_INCLUSAO&#xA;)&#xA;SELECT D.*,&#xA;cast(GETDATE() as date) AS DT_INCLUSAO&#xA;FROM &#xA;( &#xA;select COUNT(1) as QUANTIDADE,&#xA;SITUACAO_DOCUMENTO,&#xA;STATUS_INADIM,&#xA;MAILING_ATUAL,&#xA;MAILING_ANTERIOR,&#xA;TIPO_DOC&#xA;from &#xA;(&#xA;&#x9;select *, &#xA;&#x9;CASE WHEN b.CD_LETRA = 'D' THEN 'MANTEVE NEGADO'&#xA;&#x9;WHEN b.CD_LETRA IN ('K','R','S','W') THEN  'MIGROU PARA NEGADO'&#xA;&#x9;else 'MANTEVE NEGADO'&#xA;&#x9;END AS SITUACAO_DOCUMENTO,&#xA;&#x9;CASE WHEN CD_LETRA NOT In ('D','L') THEN 'ENTRANTE'&#xA;&#x9;WHEN CD_LETRA In ('D','L') THEN 'MANTEVE'&#xA;&#x9;END AS STATUS_INADIM,&#xA;&#x9;B.CD_LETRA AS MAILING_ATUAL,&#xA;&#x9;'D' AS  MAILING_ANTERIOR,&#xA;&#x9;TIPO_DOC AS TIPO_DOCUMENTO&#xA;&#x9;FROM &#xA;&#x9;( &#xA;&#x9;&#x9;select * from&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;select &#xA;&#x9;&#x9;&#x9;CHAVE as numero_documento,&#xA;&#x9;&#x9;&#x9;sum(VL_FATURADO) as total &#xA;&#x9;&#x9;&#x9;from TB_CRDT_BASE_INADIMPLENCIA_LEGADO_NF_ENTRADA a &#xA;&#x9;&#x9;&#x9;where ATRASO &gt; 30&#xA;&#x9;&#x9;&#x9;group by CHAVE&#xA;&#x9;&#x9;) a where total &gt; 100&#xA;&#x9;) A  inner join tb_crdt_classlist_oi_export b on A.numero_documento = b.nr_pessoa&#xA;) b &#xA;&#xA;group by STATUS_INADIM,MAILING_ATUAL,MAILING_ANTERIOR,SITUACAO_DOCUMENTO,TIPO_DOC&#xA;&#xA;UNION ALL &#xA;---- novos clientes&#xA;&#xA;select COUNT(1) as qtd,&#xA;&#x9;&#x9;'MIGROU PARA NEGADO' AS SITUACAO_DOCUMENTO,&#xA;&#x9;   'ENTRANTE' AS STATUS_INADIM,&#xA;&#x9;   'D' AS MAILING_ATUAL,&#xA;&#x9;   '' AS MAILING_ANTERIOR,&#xA;&#x9;   TIPO_DOC AS TIPO_DOCUMENTO&#xA;from &#xA;(&#xA;&#x9;&#x9;select C.*,&#xA;&#x9;case when d.SCORE_PJ_CUSTOMIZADO IS null then 2 else 1 end as TIPO_DOC&#xA;&#x9;&#xA;&#x9;from&#xA;&#x9;(&#xA;&#x9;&#xA;&#x9;&#x9;select a.*,&#xA;&#x9;&#x9;b.NR_PESSOA&#xA;&#x9;&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;( &#xA;&#x9;&#x9;&#x9;select * from&#xA;&#x9;&#x9;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;select &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;CHAVE as numero_documento,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;sum(VL_FATURADO) as total &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;from TB_CRDT_BASE_INADIMPLENCIA_LEGADO_NF_ENTRADA a &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;where ATRASO &gt; 30&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;group by CHAVE&#xA;&#x9;&#x9;&#x9;&#x9;) a where total &gt; 100&#xA;&#xA;&#x9;&#x9;&#x9;) A  left join tb_crdt_classlist_oi_export b on A.numero_documento = b.nr_pessoa&#xA;&#x9;) C &#xA;&#x9;&#xA;&#x9;left join TB_CRDT_BASE_QUOD_FULL_PJ d on C.numero_documento = d.CNPJ&#xA;&#x9;&#xA;)  b  where NR_PESSOA is null&#xA;GROUP BY TIPO_DOC&#xA;) D;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\LIMPAR BASE"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarefa Executar SQL"
      DTS:DTSID="{8E402632-4583-45DB-A43B-4A1E2773BC38}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="LIMPAR BASE"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{557165E4-FCA5-4F9D-AB80-94F4538469D0}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE TB_CRDT_BASE_INADIMPLENCIA_LEGADO_NF_ENTRADA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\RECOMPRA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarefa Executar SQL"
      DTS:DTSID="{33989974-21b2-4e7d-850a-4b0abb2b968d}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="RECOMPRA"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{557165E4-FCA5-4F9D-AB80-94F4538469D0}"
          SQLTask:SqlStatementSource="UPDATE A&#xA;&#xA;SET A.CD_LETRA = D.CD_LETRA,&#xA;A.CD_OPERACAO = 'MAILING_PJ',&#xA;A.DT_INCLUSAO = GETDATE()&#xA;&#xA;FROM TB_CRDT_CLASSLIST_OI_EXPORT A&#xA;&#xA;INNER JOIN &#xA;(&#xA;&#xA; SELECT NR_PESSOA,&#xA; SCORE,&#xA; CASE WHEN ID_SITUACAO_CADASTRAL &lt;&gt; 'A' THEN 'L'&#xA;  ELSE &#xA;  CASE WHEN SCORE IS NULL THEN 'Q'&#xA;  WHEN SCORE &lt; 400 THEN 'Q'&#xA;  WHEN SCORE BETWEEN  400 AND 624 THEN 'K'&#xA;  WHEN SCORE   &gt;=  625 THEN 'R'&#xA;  END &#xA; END AS CD_LETRA&#xA;&#xA;&#xA; FROM &#xA; (&#xA;  SELECT A.*,&#xA;  B.SCORE &#xA;&#xA;  FROM &#xA;  (&#xA;   select NR_PESSOA,&#xA;   ID_SITUACAO_CADASTRAL,&#xA;   RIGHT('00000000000000' + DOCUMENTO,14) AS DOCUMENTO&#xA;   from &#xA;   (&#xA;    SELECT  a.*,&#xA;    b.MEI,&#xA;    b.ID_SITUACAO_CADASTRAL,&#xA;    b.SCORE_PJ_CUSTOMIZADO,&#xA;    ID_NATUREZA_JURIDICA&#xA;    FROM TB_CRDT_CLASSLIST_OI_EXPORT a &#xA;    inner join TB_CRDT_BASE_QUOD_FULL_PJ b on a.NR_PESSOA = b.CNPJ&#xA;&#xA;    WHERE CD_LETRA IS NULL and TIPO_DOC = '2'&#xA;   ) a&#xA;   INNER JOIN TB_CRDT_QUOD_BASE_QUADRO_SOCIETARIO B ON a.NR_PESSOA = B.CNPJ&#xA; &#xA;   where MEI = 'S'&#xA;  ) A &#xA;  INNER JOIN TB_CRDT_BASE_EQUIFAX B ON A.DOCUMENTO = B.cpf&#xA; ) C&#xA;) D&#xA;&#xA;ON A.NR_PESSOA = D.NR_PESSOA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\REORGANIZAR ÍNDICE"
